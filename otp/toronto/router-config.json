{
  "server": {
    "apiProcessingTimeout": "30s"
  },
  "routingDefaults": {
    "_comment": "Neither the TTC nor Bogotá publish usable trip/stop accessibility data, so unknown is allowed with a cost instead of excluding every trip in wheelchair mode.",
    "wheelchairAccessibility": {
      "trip": {
        "onlyConsiderAccessible": false,
        "unknownCost": 600,
        "inaccessibleCost": 3600
      },
      "stop": {
        "onlyConsiderAccessible": false,
        "unknownCost": 600,
        "inaccessibleCost": 3600
      },
      "elevator": {
        "onlyConsiderAccessible": false,
        "unknownCost": 20,
        "inaccessibleCost": 3600
      },
      "inaccessibleStreetReluctance": 25.0,
      "maxSlope": 0.083,
      "slopeExceededReluctance": 1.0,
      "stairsReluctance": 100.0
    },
    "maxDirectStreetDuration": "PT3H"
  },
  "updaters": [
    {
      "type": "real-time-alerts",
      "frequency": "60s",
      "url": "https://gtfsrt.ttc.ca/alerts/all?format=binary",
      "feedId": "toronto"
    },
    {
      "type": "vehicle-positions",
      "frequency": "20s",
      "url": "https://gtfsrt.ttc.ca/vehicles/position?format=binary",
      "feedId": "toronto",
      "fuzzyTripMatching": false,
      "features": [
        "position"
      ]
    },
    {
      "type": "vehicle-rental",
      "sourceType": "gbfs",
      "network": "bike_share_toronto",
      "url": "https://tor.publicbikesystem.net/customer/gbfs/v3.0/gbfs.json",
      "language": "en",
      "frequency": "60s",
      "allowKeepingRentedVehicleAtDestination": false,
      "geofencingZones": true
    }
  ]
}
