{
  "server": {
    "apiProcessingTimeout": "30s"
  },
  "routingDefaults": {
    "_comment": "Bogotá publishes no trip/stop accessibility data (wheelchair_boarding=1 everywhere, no wheelchair_accessible on trips). With OTP's defaults every trip would be excluded in wheelchair mode; unknown is allowed with a cost instead.",
    "wheelchairAccessibility": {
      "trip": {
        "onlyConsiderAccessible": false,
        "unknownCost": 600,
        "inaccessibleCost": 3600
      },
      "stop": {
        "onlyConsiderAccessible": false,
        "unknownCost": 600,
        "inaccessibleCost": 3600
      },
      "elevator": {
        "onlyConsiderAccessible": false,
        "unknownCost": 20,
        "inaccessibleCost": 3600
      },
      "inaccessibleStreetReluctance": 25.0,
      "maxSlope": 0.083,
      "slopeExceededReluctance": 1.0,
      "stairsReluctance": 100.0
    },
    "maxDirectStreetDuration": "PT3H"
  },
  "updaters": [
    {
      "type": "real-time-alerts",
      "frequency": "60s",
      "url": "https://gtfsrt.ttc.ca/alerts/all?format=binary",
      "feedId": "toronto"
    },
    {
      "type": "vehicle-positions",
      "frequency": "20s",
      "url": "https://gtfsrt.ttc.ca/vehicles/position?format=binary",
      "feedId": "toronto",
      "fuzzyTripMatching": false,
      "features": [
        "position"
      ]
    }
  ]
}
