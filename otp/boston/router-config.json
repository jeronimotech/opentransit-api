{
  "server": {
    "apiProcessingTimeout": "30s"
  },
  "routingDefaults": {
    "_comment": "Few feeds publish usable trip/stop accessibility data, so unknown is allowed with a cost instead of excluding every trip in wheelchair mode.",
    "wheelchairAccessibility": {
      "trip": {
        "onlyConsiderAccessible": false,
        "unknownCost": 600,
        "inaccessibleCost": 3600
      },
      "stop": {
        "onlyConsiderAccessible": false,
        "unknownCost": 600,
        "inaccessibleCost": 3600
      },
      "elevator": {
        "onlyConsiderAccessible": false,
        "unknownCost": 20,
        "inaccessibleCost": 3600
      },
      "inaccessibleStreetReluctance": 25.0,
      "maxSlope": 0.083,
      "slopeExceededReluctance": 1.0,
      "stairsReluctance": 100.0
    },
    "maxDirectStreetDuration": "PT3H"
  },
  "updaters": [
    {
      "type": "stop-time-updater",
      "frequency": "30s",
      "url": "https://cdn.mbta.com/realtime/TripUpdates.pb",
      "feedId": "boston",
      "fuzzyTripMatching": false
    },
    {
      "type": "real-time-alerts",
      "frequency": "60s",
      "url": "https://cdn.mbta.com/realtime/Alerts.pb",
      "feedId": "boston"
    },
    {
      "type": "vehicle-positions",
      "frequency": "20s",
      "url": "https://cdn.mbta.com/realtime/VehiclePositions.pb",
      "feedId": "boston",
      "fuzzyTripMatching": false,
      "features": [
        "position"
      ]
    },
    {
      "type": "vehicle-rental",
      "sourceType": "gbfs",
      "network": "lyft_bos",
      "url": "https://gbfs.bluebikes.com/gbfs/gbfs.json",
      "language": "en",
      "frequency": "60s",
      "allowKeepingRentedVehicleAtDestination": false,
      "geofencingZones": true
    }
  ]
}
