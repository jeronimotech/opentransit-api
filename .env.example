# Copy to .env. Every value has a sane dev default.
DATABASE_URL=postgresql://opentransit:opentransit@localhost:5435/opentransit
CITIES_DIR=cities
ADMIN_TOKEN=change-me
CORS_ORIGINS=*
LOG_LEVEL=INFO
LOG_JSON=false
ENABLE_RT_POLLERS=true
ENABLE_STATIC_INGEST=true
STATIC_INGEST_ON_START=true
INGEST_STOP_ROUTES=true
# Per-city OTP base URLs are referenced from cities/<city>.yaml as ${OTP_<CITY>_URL:-...}
OTP_BOGOTA_URL=http://localhost:8080
