# Copy to .env. Every value has a sane dev default except ADMIN_TOKEN.
DATABASE_URL=postgresql://opentransit:opentransit@localhost:5435/opentransit
CITIES_DIR=cities
# Machine credential for /v1/admin/* (CI, cron, `make ingest`). People sign in with their own account
# instead — see scripts/admin_user.py. Generate a random one: openssl rand -hex 32 — never commit it.
ADMIN_TOKEN=replace-with-openssl-rand-hex-32
# Set to false once nothing automated uses X-Admin-Token: then only named accounts can reach /v1/admin/*.
ADMIN_TOKEN_ENABLED=true
ADMIN_SESSION_HOURS=12
# One-shot seed for a fresh deployment: creates the first owner, then does nothing forever after.
# Leave empty and use `python scripts/admin_user.py create-owner <email>` instead if you prefer.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=

# ─────────── Sign in with Google / Microsoft (OpenID Connect + PKCE) ───────────
# Both providers are OFF unless their client id *and* secret are set here. Secrets belong in the
# deployment's environment, never in this file or in git. See docs/DEPLOY-RAILWAY.md §4c for the exact
# redirect URIs to register, and SECURITY.md for what signing in with a provider does and does not do.
#
# Signing in with a provider NEVER creates an account: it signs in an existing, enabled admin_user
# matched on the verified email. An owner invites people first.
#
# The public origin of the web client. The redirect URI is this + /admin/auth/callback/<provider>,
# and it must match the console registration exactly. Falls back to WEB_BASE_URL.
OIDC_REDIRECT_BASE=
OIDC_STATE_TTL_SECONDS=600
# Localhost development only: allows an http:// redirect base. Never set this in production.
OIDC_ALLOW_INSECURE_HTTP=false

# Google Cloud console → APIs & Services → Credentials → OAuth client ID → Web application.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Entra admin center → App registrations → your app. MICROSOFT_TENANT is your Directory (tenant) ID.
# Anything other than a tenant GUID (common / organizations / consumers / a domain) ALSO needs
# MICROSOFT_ALLOWED_TENANT_IDS, or Microsoft sign-in stays off: Entra signs every tenant on earth with
# the same keys, so without an allowlist a stranger's tenant could mint a token naming your operator.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=
MICROSOFT_ALLOWED_TENANT_IDS=

# DANGEROUS, OFF BY DEFAULT, AND IT SHOULD STAY OFF. A verified address at one of these domains gets an
# admin account created on first sign-in instead of being refused. That means "whoever can get an
# address at this domain" can reach the admin panel. Only for a corporate directory whose account
# lifecycle you actually control, and even then keep the role at `viewer`. See SECURITY.md.
OIDC_AUTO_PROVISION_DOMAINS=
OIDC_AUTO_PROVISION_ROLE=viewer
OIDC_AUTO_PROVISION_CITIES=

CORS_ORIGINS=*
LOG_LEVEL=INFO
LOG_JSON=false
ENABLE_RT_POLLERS=true
ENABLE_STATIC_INGEST=true
STATIC_INGEST_ON_START=true
INGEST_STOP_ROUTES=true
# OpenTripPlanner: OTP_URL is the default router for every city; OTP_<CITY>_URL (e.g. OTP_BOGOTA_URL) overrides
# it for one city. cities/<city>.yaml reads ${OTP_<CITY>_URL:-${OTP_URL:-http://localhost:8080}}.
OTP_URL=http://localhost:8080
# Public base URL of the web client. A shared trip link must open a page a person can
# read; the API only speaks JSON, so without this the link shows raw JSON to whoever
# receives it. Per-city override: `share.webBaseUrl` in cities/<city>.yaml or the admin.
WEB_BASE_URL=http://localhost:3000
# v1.4 on-demand providers: cities/*.yaml may reference per-provider credentials from the environment
# (e.g. `credentials: { clientId: "${UBER_CLIENT_ID:-}" }`). Leave empty to fall back to the provider's store/web link.
UBER_CLIENT_ID=

# v1.5 analytics jobs (rollup, partitions, retention). Turn off on read replicas.
ENABLE_ANALYTICS_JOBS=true
ANALYTICS_ROLLUP_SECONDS=600
